# Entity: post

main: kit: entity: post: {

  alias: field: {}

  fields: [
    {
      name: "content"
      req: false
      short: "Content or description of the prank"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "date"
      req: false
      short: "Publication date of the prank"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the prank post"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the prank"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "URL to the full prank post"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "post"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/posts/get"
          segments: [
            {
              lit: "posts"
            }
            {
              lit: "get"
            }
          ]
          select: {
            "$action": "get"
            exist: [
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.posts`"
          }
        }
      ]
    }
  }



}
